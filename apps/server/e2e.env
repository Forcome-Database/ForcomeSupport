# Playwright 用的 api（scripts/e2e-api.ts）：e2e 专用库 forcome_e2e（每次启动重建）、端口 4518；
# 前端预览服务器 4519 把 /api 转到 4518（apps/web/playwright.config.ts）。
APP_ENV=test
DATABASE_URL=postgres://forcome:forcome@127.0.0.1:4520/forcome_e2e
PORT=4518
LOG_LEVEL=warn
DEV_LOGIN_ENABLED=true
# 主密钥只给 e2e 用（P18 登记 163 企业邮箱时加密客户端授权码，待办 35）：公开的固定值，不能用于任何部署环境
CREDENTIAL_MASTER_KEY=Zm9yY29tZS1kZXYtb25seS1tYXN0ZXIta2V5LTAwMDE=
