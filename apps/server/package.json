{
  "name": "@forcome/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "后端：模块化单体，api、worker、migrate 三个入口（ADR 0005、0006、0008）",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "dev:api": "tsx watch --env-file=dev.env src/api.ts",
    "dev:worker": "tsx watch --env-file=dev.env src/worker.ts",
    "e2e:api": "tsx --env-file=e2e.env scripts/e2e-api.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file=dev.env src/migrate.ts",
    "db:seed": "tsx --env-file=dev.env src/seed.ts",
    "db:reset-inbound": "tsx --env-file=dev.env src/reset-inbound.ts",
    "import:aftersales": "tsx --env-file=dev.env src/import-aftersales.ts",
    "sp-api-token": "tsx --env-file=dev.env src/sp-api-token.ts",
    "order-backfill": "tsx --env-file=dev.env src/order-backfill.ts",
    "mail-replay": "tsx --env-file=dev.env src/mail-replay.ts",
    "history:sample": "tsx scripts/history-import-sample.ts"
  },
  "dependencies": {
    "@forcome/calendar": "workspace:*",
    "@forcome/contracts": "workspace:*",
    "@forcome/fixtures": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/signature-v4": "^5.7.4",
    "big.js": "^7.0.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.12",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.12",
    "p-throttle": "^8.1.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "postal-mime": "^4.0.4",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@forcome/config": "workspace:*",
    "@types/big.js": "^7.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "tsdown": "0.23.0",
    "tsx": "^4.20.0"
  }
}
