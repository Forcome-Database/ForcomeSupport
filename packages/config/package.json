    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "~6.0.3"
  }
