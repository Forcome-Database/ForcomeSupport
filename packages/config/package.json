{
  "name": "@forcome/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "共享的 TypeScript 与 ESLint 配置（ADR 0005）",
  "exports": {
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint.js",
    "./eslint-boundaries": "./eslint-boundaries.js"
  },
