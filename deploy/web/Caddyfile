# caddy（ADR 0003、0007、0013）：内网 HTTPS、托管前端静态文件、把 /api 转给 api。
# 变量来自 Compose：SITE_HOST 内网域名，TLS_MODE 证书方式（目前只有 internal）。
{
	# 容器里没有要装根证书的系统证书库；根证书由部署脚本导出、发给员工浏览器安装
	skip_install_trust
	# 浏览器按 IP 访问时不发 SNI，容器里也拿不到外部 IP：没有 SNI 的握手用这个名字选证书（Compose 给出：SITE_IP，没填时 SITE_HOST）
	default_sni {$SITE_DEFAULT_SNI}
	pki {
		ca local {
			name "Forcome Support"
			root_cn "Forcome Support Internal Root CA"
			intermediate_cn "Forcome Support Internal Intermediate CA"
		}
	}
}

# 内部 CA（tls internal）：根证书在 caddy_data 卷的 /data/caddy/pki/authorities/local/root.crt，
# 卷不删就一直是同一个根证书。公司域名与 DNS-01 到位后加一个 (tls_dns) 片段并把 TLS_MODE 改为 dns（docs/部署说明.md）。
(tls_internal) {
	tls internal
}

# SITE_IP（可选）：另外直接按 IP 访问，内部 CA 给这个 IP 签证书（没有内网域名与 DNS 时验证用）
{$SITE_HOST} {$SITE_IP} {
	import tls_{$TLS_MODE:internal}
	# 实时推送（/api/live，SSE，待办 18）不压缩：压缩要攒够字节才写出，推送会被压着不发
	@compressible not path /api/live
	encode @compressible zstd gzip
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# 接口：X-Forwarded-For 用真实客户端地址改写、不信任客户端自带的值（不设 trusted_proxies），
	# api 取它的第一段记审计（ADR 0010 修订）
	handle /api/* {
		reverse_proxy api:3000
	}

	# 前端单页：带哈希的资源长期缓存，index.html 每次校验，其余路径交给前端路由
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
