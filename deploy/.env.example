# 部署环境变量模板（ADR 0013）。部署脚本读取 deploy/.env.<环境>（不进 git；服务器上放到工作区以外，
# 用 FORCOME_ENV_FILE 指过去，权限 600）。第一次在本机部署开发测试环境时，脚本从本文件生成
# deploy/.env.staging 并填入随机口令；生产环境（28 号待办）由运维按本模板手工填写。说明见 docs/部署说明.md。

# ── 运行环境 ──
# staging 开发测试环境；production 生产（28 号待办）。必须与部署的环境一致，脚本会核对
APP_ENV=staging
LOG_LEVEL=info
# 开发登录（绕过钉钉扫码），只能在非生产环境打开；部署后的冒烟要用它
DEV_LOGIN_ENABLED=true

# ── 访问地址 ──
# 内网域名：内网 DNS 把它解析到服务器的内网地址（本机测试见 docs/部署说明.md 第 3 节「本机用浏览器访问」）
SITE_HOST=support-dev.forcome.internal
# HTTPS 监听的地址与端口：本机测试只开在 127.0.0.1；服务器上改为 0.0.0.0 或内网网卡地址
HTTPS_BIND=127.0.0.1
# 本期本机端口：开发测试 4510（HTTPS）、4511（PostgreSQL，只开在 127.0.0.1）；生产 4512、4513（28 号待办）
HTTPS_PORT=4510
PG_PORT=4511
# 证书：internal = caddy 内部 CA（tls internal）。公司域名与 DNS-01 到位后再加 dns
TLS_MODE=internal

# ── 数据库 ──
POSTGRES_USER=forcome
# 只用字母、数字与 . _ ~ -，至少 16 位（直接拼进连接串）。部署脚本生成本机环境文件时自动换成随机值
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forcome

# ── 出站代理（ADR 0003）──
# 境外服务（Google、Shopify、亚马逊、AWS、17TRACK、欧洲央行等）经公司固定代理；没有代理时留空
HTTPS_PROXY=
HTTP_PROXY=
# 不经代理直连：内部服务名与本机地址，加上境内服务（钉钉；第二期加积加 .gerpgo.com 与易仓的 OMS 域名）。
# 域名写成带前导点的形式（.dingtalk.com），undici、curl、Go 都按「该域名的子域名」匹配
NO_PROXY=localhost,127.0.0.1,postgres,api,caddy,.dingtalk.com

# ── 发信白名单（ADR 0013 修订）──
# 留空时按环境取默认：非生产环境只向白名单发信（白名单为空即一封也不发），生产环境不限制。
# 只在要改变默认时填 true 或 false
MAIL_SEND_ALLOWLIST_ONLY=
# 逗号分隔的完整地址或 @域名，例：qa.mailbox@gmail.com,@forcome.com
MAIL_SEND_ALLOWLIST=

# ── 外部客户端 ──
# 开发测试环境默认全部用 Fake（模拟数据）。各集成的待办会在这里加 CLIENT_MODE_<系统>=real 与凭据
# （例如钉钉：05 号待办），外部接口开通后逐个切换。
