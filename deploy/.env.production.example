# 生产环境的环境变量模板（ADR 0013 修订，待办 28）。变量与开发测试环境的模板 deploy/.env.example 一一对应（测试核对），
# 说明见那里与 docs/部署说明.md 第 17 节、docs/运维手册.md。复制到服务器上工作区以外（如 /etc/forcome/production.env），
# 属主为生产运行器的系统用户、权限 600（部署脚本核对），逐项填写；change-me 的几项用 openssl 生成随机值，连同主密钥离线保管。

# ── 运行环境 ──
# staging 开发测试环境；production 生产（28 号待办）。必须与部署的环境一致，脚本会核对
APP_ENV=production
LOG_LEVEL=info
# 开发登录：生产环境不能打开（api 拒绝启动，部署脚本也核对）
DEV_LOGIN_ENABLED=false

# ── 访问地址 ──
# 内网域名：内网 DNS 把它解析到服务器的内网地址（本机测试见 docs/部署说明.md 第 3 节「本机用浏览器访问」）
SITE_HOST=support.forcome.internal
# HTTPS 监听的地址与端口：服务器上改为内网网卡地址（或 0.0.0.0）；端口按本期口径 4512（要用 443 时见部署说明 6.4）
HTTPS_BIND=127.0.0.1
# 可选：另外直接按 IP 访问时填服务器的 IP（只填一个），caddy 内部 CA 给它签证书；留空只认 SITE_HOST（生产一般留空，按内网域名访问）
SITE_IP=
# 本期本机端口：开发测试 4510（HTTPS）、4511（PostgreSQL，只开在 127.0.0.1）；生产 4512、4513（28 号待办）
HTTPS_PORT=4512
PG_PORT=4513
# 证书：internal = caddy 内部 CA（tls internal）。公司域名与 DNS-01 到位后再加 dns
TLS_MODE=internal

# ── 数据库 ──
POSTGRES_USER=forcome
# 只用字母、数字与 . _ ~ -，至少 16 位（直接拼进连接串）：openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forcome

# ── 出站代理（ADR 0003）──
# 境外服务（Google、Shopify、亚马逊、AWS、17TRACK、欧洲央行等）经公司固定代理；没有代理时留空
HTTPS_PROXY=
HTTP_PROXY=
# 不经代理直连：内部服务名与本机地址，加上境内服务（钉钉；第二期加积加 .gerpgo.com 与易仓的 OMS 域名）。
# 域名写成带前导点的形式（.dingtalk.com），undici、curl、Go 都按「该域名的子域名」匹配
NO_PROXY=localhost,127.0.0.1,postgres,api,caddy,.dingtalk.com

# ── 发信白名单（ADR 0013 修订）──
# 留空时按环境取默认：非生产环境只向白名单发信（白名单为空即一封也不发），生产环境不限制。
# 只在要改变默认时填 true 或 false
MAIL_SEND_ALLOWLIST_ONLY=
# 逗号分隔的完整地址或 @域名，例：qa.mailbox@gmail.com,@forcome.com
MAIL_SEND_ALLOWLIST=

# ── 外部客户端 ──
# 开发测试环境默认全部用 Fake（模拟数据）。各集成的待办会在这里加 CLIENT_MODE_<系统>=real 与凭据，
# 外部接口开通后逐个切换。

# ── 钉钉企业内部应用（待办 05；在钉钉开放平台要做的配置与切换步骤见 docs/部署说明.md 第 11 节）──
# 留空时按环境取默认：开发测试环境用 Fake（模拟数据，登录用开发登录或模拟扫码），生产环境用真实接口。
# 开发测试环境要连真实钉钉时填 real，并填下面的凭据
CLIENT_MODE_DINGTALK=
# 应用凭证：钉钉开放平台 → 应用开发 → 企业内部应用 → 本应用 →「凭证与基础信息」。用真实接口时三项必填，缺了 api 拒绝启动。
# Client ID（原 AppKey）与 Client Secret（原 AppSecret）：换访问凭证、扫码登录、Stream 长连接
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 应用的 AgentId（数字）：发工作通知
DINGTALK_AGENT_ID=

# ── Gmail：Google 服务账号与 Pub/Sub（待办 09；在 Google Cloud 与 Workspace 要做的配置与切换步骤见 docs/部署说明.md 第 12 节）──
# 推送（Pub/Sub 订阅）留空时按环境取默认：开发测试环境用 Fake，生产环境用真实接口；店铺邮箱按 P18 店铺的「数据来源」选择。
# 开发测试环境要连真实 Gmail 时填 real，并填下面三项
CLIENT_MODE_GMAIL_PUSH=
# 服务器上放服务账号密钥（JSON）的目录，只读挂进容器的 /run/forcome-keys（目录与文件权限 600，不进 git）；留空挂 deploy/keys（空目录）
GOOGLE_KEY_DIR=
# 密钥文件在容器里的路径（三项要么都填要么都不填，只填一部分 api 拒绝启动；都不填照常启动，Gmail 为「未连接」，生产也一样）
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# watch 推送的主题与本环境的订阅（各环境独立）：projects/<项目>/topics/<主题>、projects/<项目>/subscriptions/<订阅>
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=

# ── Shopify 订单：自建应用的客户端凭据与主密钥（待办 11；在 Shopify 侧要做的配置与切换步骤见 docs/部署说明.md 第 13 节）──
# 店铺按 P18 的「数据来源」选择：生产环境的店铺都是真实接口；开发测试环境的店铺默认模拟数据。
# Dev Dashboard 里应用的 Client ID 与 Client secret：两项要么都填要么都不填（只填一项 api 拒绝启动；都不填照常启动，
# Shopify 与各店铺的订单为「未连接」，生产也一样）
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── 亚马逊订单：SP-API 私有应用与订单通知队列（待办 12；在 Seller Central 与 AWS 要做的配置与切换步骤见 docs/部署说明.md 第 14 节）──
# 店铺按 P18 的「数据来源」选择：生产环境的店铺都是真实接口；开发测试环境的店铺默认模拟数据。
# 私有应用的 LWA 凭据（Client ID 与 Client secret）：两项要么都填要么都不填（只填一项 api 拒绝启动；都不填照常启动，
# 亚马逊与各店铺的订单为「未连接」，生产也一样）。各卖家授权的刷新令牌不写在这里：部署后用子命令
# node deploy/deploy.mjs <环境> sp-api-token --seller <卖家 ID> < <放刷新令牌的文件> 加密存库（第 14.2 节）
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
# ORDER_CHANGE 通知投递的 SQS 标准队列（us-east-1，各环境一个）与只能读、删这个队列的 IAM 访问密钥：三项要么都填要么都不填
# （都不填照常启动，亚马逊卡的「订单通知队列（SQS）」为「未连接」，订单靠每 4 分钟的增量兜底）。
# 推送留空时按环境取默认：开发测试环境用 Fake，生产环境用真实接口；开发测试环境要连真实队列时 CLIENT_MODE_AMAZON_SQS 填 real
CLIENT_MODE_AMAZON_SQS=
AMAZON_SQS_QUEUE_URL=
AMAZON_SQS_ACCESS_KEY_ID=
AMAZON_SQS_SECRET_ACCESS_KEY=

# ── 主密钥（待办 11、12）──
# 32 字节的 base64（openssl rand -base64 32 生成）：动态凭据（各店铺的 Shopify 访问令牌、各卖家授权的 SP-API 刷新令牌）用它
# AES-256-GCM 加密存库。填了 Shopify 或 SP-API 凭据就必填；随备份单独离线保管：换了它库里的 Shopify 令牌解不开时系统会自动重新换，
# SP-API 刷新令牌则要用 sp-api-token 子命令重新录入
CREDENTIAL_MASTER_KEY=

# ── 备份（待办 28；docs/运维手册.md 第 2–4 节）──
# 备份目录：生产写 NAS 挂载到服务器上的目录（必填，绝对路径，属主 uid 999，见手册）；开发测试环境留空，用本项目的命名卷 backup
BACKUP_DIR=/mnt/nas/forcome-support
# WAL-G 加密基础备份与 WAL 的密钥（openssl rand -hex 32）与 restic 仓库的口令（openssl rand -hex 24）。部署脚本生成本机环境文件时
# 自动换成随机值。两项连同主密钥、数据库口令单独离线保管（手册第 5 节）：丢了就解不开备份
WALG_LIBSODIUM_KEY=change-me
RESTIC_PASSWORD=change-me
# 每天几点备份（cron，北京时间）与保留：restic 近 N 天每天 1 份、近 M 个月每月 1 份；WAL-G 至少 K 份基础备份与近 K 天的全部
BACKUP_CRON=30 2 * * *
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
WALG_RETAIN_FULL=7

# ── 告警：运维群的钉钉自定义机器人（待办 28；docs/运维手册.md 第 6 节）──
# 留空时按环境取默认：开发测试环境用 Fake（告警只写 worker 日志），生产环境用真实接口。开发测试环境演练告警时填 real，
# Webhook 指到接收替身 http://robot-sink:8080/robot/send?access_token=drill（手册第 6.3 节）
CLIENT_MODE_DINGTALK_ROBOT=
# 群设置 → 智能群助手 → 添加机器人 → 自定义：安全设置选「加签」，复制 Webhook（带 access_token）与 SEC 开头的密钥。
# 没填 Webhook 时照常启动，告警只写日志；宿主机检查（host-check）也用这两项
DINGTALK_ROBOT_WEBHOOK=
DINGTALK_ROBOT_SECRET=
# 宿主机检查：worker 心跳超过几分钟没更新算「心跳停止」
HOST_CHECK_HEARTBEAT_MINUTES=3
# worker 自检的阈值（留空取默认值：队列积压 10 分钟、失败任务看近 60 分钟、外部调用近 15 分钟 ≥10 次且失败 ≥50%、
# 钉钉本月 4,000 次、SQS 10 分钟没检查、对账 24 小时未完成、备份 26 小时没成功、持续异常每 2 小时再提醒）
ALERT_QUEUE_WAIT_MINUTES=
ALERT_FAILED_JOB_WINDOW_MINUTES=
ALERT_CALL_ERROR_WINDOW_MINUTES=
ALERT_CALL_ERROR_MIN_CALLS=
ALERT_CALL_ERROR_PERCENT=
ALERT_DINGTALK_MONTHLY_CALLS=
ALERT_SQS_CHECK_STALE_MINUTES=
ALERT_RECONCILE_STALE_HOURS=
ALERT_BACKUP_STALE_HOURS=
ALERT_REPEAT_HOURS=

# ── 日志（ADR 0013：Docker json-file 轮转）──
# 每个容器最多 LOG_MAX_FILE 个、每个 LOG_MAX_SIZE 的日志文件（默认 30 × 20m，按第一期的量能留 30 天以上；手册第 7 节）
LOG_MAX_SIZE=20m
LOG_MAX_FILE=30
