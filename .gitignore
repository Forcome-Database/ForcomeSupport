# Python 缓存
__pycache__/
*.pyc

# 工具运行时产生的临时文件
.playwright-mcp/
.firecrawl/

# 临时局部截图（shot_doc.py 输出）
design/spec/shots/doc_*.png

# 代理的临时工作树
.claude/worktrees/

# Node 与构建产物
node_modules/
dist/
coverage/
*.tsbuildinfo

# Playwright 的运行结果
test-results/
playwright-report/
blob-report/

# 本机环境变量（.env.example 进仓库）
.env
.env.*
!.env.example
!.env.production.example

# 部署产物：导出的根证书、部署报告与冒烟报告（deploy/deploy.mjs）
deploy/.state/

# Google 服务账号密钥（deploy/keys 只留空目录，待办 09）
deploy/keys/*
!deploy/keys/.gitkeep
